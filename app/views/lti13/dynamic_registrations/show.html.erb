<div style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; padding: 24px; max-width: 640px; margin: 0 auto; color: #222;">
  <% if @error %>
    <h2 style="color: #d9534f; margin-top: 0;">Registration Error</h2>
    <p style="line-height: 1.5;"><%= @error %></p>
  <% else %>
    <h2 style="margin-top: 0;">Register OpenDSA with this LMS?</h2>
    <p style="line-height: 1.5;">
      This will create a new LTI 1.3 <code>LmsInstance</code> record in OpenDSA
      and register OpenDSA as a tool with the platform below. A new RSA keypair
      will be generated for this instance.
    </p>

    <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
      <tr>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee; font-weight: 600; width: 35%;">Issuer</td>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee;"><code><%= @issuer %></code></td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee; font-weight: 600;">JWKS URL</td>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee;"><code><%= @platform_config['jwks_uri'] %></code></td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee; font-weight: 600;">Token endpoint</td>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee;"><code><%= @platform_config['token_endpoint'] %></code></td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee; font-weight: 600;">Authorization endpoint</td>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee;"><code><%= @platform_config['authorization_endpoint'] %></code></td>
      </tr>
      <tr>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee; font-weight: 600;">Registration endpoint</td>
        <td style="padding: 6px 12px; border-bottom: 1px solid #eee;"><code><%= @platform_config['registration_endpoint'] %></code></td>
      </tr>
    </table>

    <% if @existing_instance %>
      <div style="background: #fcf8e3; padding: 12px 16px; border: 1px solid #faebcc; border-radius: 4px; margin: 16px 0;">
        <strong>Warning:</strong> An <code>LmsInstance</code> for this issuer already exists
        (ID: <%= @existing_instance.id %>,
        client_id: <code><%= @existing_instance.client_id.presence || '(none)' %></code>).
        Continuing will <strong>replace its keypair and client_id</strong>.
        Any in-flight launches for the previous registration will fail.
      </div>
    <% end %>

    <%= form_tag('/lti13/dynamic_registration', method: :post) do %>
      <%= hidden_field_tag :openid_configuration, @openid_configuration %>
      <%= hidden_field_tag :registration_token, @registration_token %>
      <button type="submit"
              style="padding: 10px 24px; background: #5cb85c; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 14px;">
        Register OpenDSA
      </button>
    <% end %>
  <% end %>
</div>
